# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Origin for CORS (e.g. http://localhost:5173 for Vite dev server)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection String
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.abcde.mongodb.net/children_hospital?retryWrites=true&w=majority
